# Copy to .env.local and fill in. Never commit real values.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Free plan: a reCAPTCHA v3 site key instead (google.com/recaptcha/admin) — used when set.
NEXT_PUBLIC_RECAPTCHA_V3_SITE_KEY=
FIREBASE_SERVICE_ACCOUNT_KEY=
REVALIDATE_SECRET=
RESEND_API_KEY=
OWNER_NOTIFICATION_EMAIL=
# Free plan (no Cloud Functions): the website sends emails through Brevo when these are set.
# Leave empty if the Cloud Functions send them (Blaze plan), so nothing is sent twice.
BREVO_API_KEY=
EMAIL_FROM=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_SITE_URL=

# Pictures on Cloudinary instead of Firebase Storage (free plan). Leave empty to use Storage.
# CLOUDINARY_URL is server only — copy "API environment variable" from the Cloudinary dashboard.
CLOUDINARY_URL=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Local development against the emulators (`pnpm emulators` + `pnpm seed`):
# set NEXT_PUBLIC_FIREBASE_PROJECT_ID to demo-wizzy and add these two lines to .env.local
#   FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
#   FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# Server only: random secret used to hash client IPs for rate limiting (raw IPs are never stored)
RATE_LIMIT_SALT=
